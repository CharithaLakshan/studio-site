---
import { STATUS_LABELS, type Status } from '../lib/products';
import { STATUSES } from '../content.config';

interface Props {
  status: Status;
}
const { status } = Astro.props;
// Four squares, filled up to the current stage: concept 1, in development 2, early access 3, released 4.
const stage = STATUSES.indexOf(status) + 1;
---

<span class="status" data-status={status}>
  <span class="status-steps" aria-hidden="true">
    {[1, 2, 3, 4].map((i) => <i class:list={{ on: i <= stage }} />)}
  </span>
  {STATUS_LABELS[status]}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .status-steps {
    flex: none;
    display: inline-flex;
    gap: 2px;
  }

  .status-steps i {
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--color-ink);
  }

  .status-steps i.on {
    background: var(--color-ink);
  }

  [data-status='released'] .status-steps i.on {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }
</style>
