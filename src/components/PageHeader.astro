---
interface Props {
  title: string;
  /** Small mono kicker above the title. */
  label?: string;
  lede?: string;
}
const { title, label, lede } = Astro.props;
---

<header class="page-header">
  <div class="container page-header-inner">
    {label && <p class="label">{label}</p>}
    <h1 class="display">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    border-bottom: var(--rule-thick);
  }

  .page-header-inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
</style>
