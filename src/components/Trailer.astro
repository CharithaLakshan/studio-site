---
import { Image } from 'astro:assets';
import { responsive } from '../lib/images';
import type { ImageMetadata } from 'astro';

interface Props {
  youTubeId: string;
  title: string;
  poster: ImageMetadata;
}
const { youTubeId, title, poster } = Astro.props;
---

<div class="trailer" data-trailer={youTubeId} data-title={`${title} trailer`}>
  <a class="trailer-poster" href={`https://www.youtube.com/watch?v=${youTubeId}`}>
    <Image src={poster} alt="" {...responsive(poster, [640, 1024, 1600], '(min-width: 64rem) 60rem, 100vw')} />
    <span class="trailer-play button button--primary">
      <span class="trailer-icon" aria-hidden="true"></span>
      Play the {title} trailer
    </span>
  </a>
  <p class="trailer-note">Plays from YouTube. Nothing loads from YouTube until you press play.</p>
</div>

<script>
  // Swap the poster link for a youtube-nocookie iframe on click. Without JS the link opens YouTube.
  for (const el of document.querySelectorAll<HTMLElement>('[data-trailer]')) {
    el.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.trailer}?autoplay=1&rel=0`;
      frame.title = el.dataset.title ?? 'Trailer';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      el.querySelector('.trailer-poster')?.replaceWith(frame);
      frame.focus();
    });
  }
</script>

<style>
  .trailer {
    display: grid;
    gap: var(--space-2);
  }

  .trailer-poster,
  .trailer :global(iframe) {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 2px solid var(--color-ink);
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .trailer-poster > :global(*) {
    grid-area: 1 / 1;
  }

  .trailer-poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trailer-play {
    place-self: center;
  }

  .trailer-poster:hover .trailer-play {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-print-hover);
  }

  .trailer-icon {
    width: 0;
    height: 0;
    border-block: 0.4rem solid transparent;
    border-left: 0.65rem solid currentColor;
  }

  .trailer-note {
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
</style>
