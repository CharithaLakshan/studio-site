---
import { Image } from 'astro:assets';
import { responsive } from '../lib/images';
import SpecTable from './SpecTable.astro';
import StoreButtons from './StoreButtons.astro';
import { productUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const d = product.data;
---

<article class="featured" aria-label={`${d.title}, featured`}>
  <div class="featured-media">
    <Image
      src={d.heroImage.src}
      alt={d.heroImage.alt}
      {...responsive(d.heroImage.src, [640, 1024, 1600], '(min-width: 64rem) 50rem, 100vw')}
    />
  </div>
  <div class="featured-body">
    <p class="featured-tagline">{d.tagline}</p>
    <SpecTable product={product} rows="short" caption={`${d.title} at a glance`} />
    <StoreButtons product={product} layout="row" />
    <a class="button button--primary featured-cta" href={productUrl(product)}>
      View {d.title} <span class="button-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .featured {
    display: grid;
    border: 2px solid var(--color-ink);
    background: var(--color-card);
    box-shadow: 8px 8px 0 var(--color-ink);
    margin: 0 8px 8px 0;
  }

  .featured-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--color-ink);
    background: var(--color-paper-2);
  }

  .featured-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
  }

  .featured-body > :global(.spec-table),
  .featured-body > :global(.stores) {
    width: 100%;
  }

  .featured-tagline {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    max-width: 30ch;
  }

  @media (min-width: 64rem) {
    .featured {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .featured-media {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 2px solid var(--color-ink);
    }

    .featured-body {
      padding: var(--space-6);
    }
  }
</style>
