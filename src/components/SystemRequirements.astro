---
import type { Product } from '../lib/products';

interface Props {
  requirements: NonNullable<Product['data']['systemRequirements']>;
}
const { minimum, recommended } = Astro.props.requirements;
const rows = [...new Set([...Object.keys(minimum), ...Object.keys(recommended ?? {})])];
---

<div class="sysreq">
  <table class="spec-table">
    <caption class="visually-hidden">System requirements</caption>
    <thead>
      <tr>
        <td></td>
        <th scope="col">Minimum</th>
        {recommended && <th scope="col">Recommended</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row}</th>
            <td>{minimum[row] ?? '—'}</td>
            {recommended && <td>{recommended[row] ?? '—'}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .sysreq {
    overflow-x: auto;
  }

  thead th,
  thead td {
    border-top: 0;
    width: auto;
  }
</style>
