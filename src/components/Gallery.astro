---
import { Image } from 'astro:assets';
import { responsive } from '../lib/images';
import { pad2, type Product } from '../lib/products';

interface Props {
  images: Product['data']['screenshots'];
}
const { images } = Astro.props;
const total = pad2(images.length);
---

<ul class="gallery" role="list">
  {
    images.map((img, i) => (
      <li>
        <figure>
          <a href={img.src.src} class="gallery-link">
            <Image
              src={img.src}
              alt={img.alt}
              {...responsive(img.src, [480, 800, 1200], '(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw')}
            />
            <span class="visually-hidden">(open full size)</span>
          </a>
          <figcaption class="label">
            {pad2(i + 1)} / {total}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .gallery figure {
    display: grid;
    gap: var(--space-2);
  }

  .gallery-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    background: var(--color-paper-2);
  }

  .gallery-link:hover {
    border-color: var(--color-blue);
  }

  .gallery-link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
