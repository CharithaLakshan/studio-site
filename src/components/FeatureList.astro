---
import { pad2 } from '../lib/products';

interface Props {
  features: string[];
}
const { features } = Astro.props;
---

<ol class="feature-list" role="list">
  {
    features.map((f, i) => (
      <li>
        <span class="feature-index" aria-hidden="true">{pad2(i + 1)}</span>
        <span>{f}</span>
      </li>
    ))
  }
</ol>

<style>
  .feature-list {
    padding: 0;
    list-style: none;
    border-top: var(--rule);
  }

  .feature-list li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--rule);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .feature-index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-blue);
  }
</style>
