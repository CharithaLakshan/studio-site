---
import { storeButtons, type Product } from '../lib/products';

interface Props {
  product: Product;
  /** "stack": full-width column (buy box). "row": wrapping row (featured card). */
  layout?: 'stack' | 'row';
}
const { product, layout = 'stack' } = Astro.props;
const buttons = storeButtons(product.data);
const hasPlanned = buttons.some((b) => !b.href);
---

{
  buttons.length > 0 && (
    <div class:list={['stores', `stores--${layout}`]}>
      <ul role="list">
        {buttons.map((b) => (
          <li>
            {b.href ? (
              <a class:list={['button', { 'button--primary': b.primary }]} href={b.href} rel="noopener">
                {b.label} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="button button--soon">
                {b.name}
                <span class="visually-hidden">, </span>
                <span class="soon">Coming soon</span>
              </span>
            )}
          </li>
        ))}
      </ul>
      {hasPlanned && layout === 'stack' && (
        <p class="stores-note">“Coming soon” marks stores I plan to release on. The button goes live when the store page does.</p>
      )}
    </div>
  )
}

<style>
  .stores ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .stores--stack ul {
    flex-direction: column;
  }

  .stores--stack .button {
    width: 100%;
    justify-content: space-between;
    min-height: 3.25rem;
  }

  /* Planned store: plain text in a dashed outline, muted (7:1), no hover, not focusable. */
  .button--soon {
    gap: var(--space-3);
    border-style: dashed;
    border-color: var(--color-ink-2);
    color: var(--color-ink-2);
    cursor: default;
  }

  .button--soon:hover {
    background: transparent;
    color: var(--color-ink-2);
  }

  .soon {
    font-weight: 400;
  }

  .stores-note {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
</style>
