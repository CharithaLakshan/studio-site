---
import { storeButtons, type Product } from '../lib/products';

interface Props {
  product: Product;
  /** "stack": full-width column (buy box). "row": wrapping row (featured card). */
  layout?: 'stack' | 'row';
}
const { product, layout = 'stack' } = Astro.props;
const buttons = storeButtons(product.data);
const hasPlanned = buttons.some((b) => !b.href);
---

{
  buttons.length > 0 && (
    <div class:list={['stores', `stores--${layout}`]}>
      <ul role="list">
        {buttons.map((b) => (
          <li>
            {b.href ? (
              <a class:list={['button', { 'button--primary': b.primary }]} href={b.href} rel="noopener">
                {b.label} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="button button--soon">
                <span>{b.name}</span>
                <span class="visually-hidden">, </span>
                <span class="soon">Coming soon</span>
              </span>
            )}
          </li>
        ))}
      </ul>
      {hasPlanned && layout === 'stack' && (
        <p class="stores-note">“Coming soon” marks stores I plan to release on. The button goes live when the store page does.</p>
      )}
    </div>
  )
}

<style>
  .stores ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .stores--stack ul {
    flex-direction: column;
  }

  /* Row: buttons share the line while each fits on one line of its own, else they stack. */
  .stores--row li {
    flex: 1 1 15rem;
  }

  .stores .button {
    width: 100%;
    justify-content: space-between;
  }

  .stores--stack .button {
    min-height: 3.25rem;
  }

  /*
   * Planned store: plain text in a dashed outline, muted (7.1:1 on paper, 7.9:1 on card), no hover,
   * not focusable. When the name and "Coming soon" don't fit on one line, "Coming soon" moves below.
   */
  .button--soon {
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    border-style: dashed;
    border-color: var(--color-ink-2);
    color: var(--color-ink-2);
    cursor: default;
  }

  .button--soon:hover {
    background: transparent;
    color: var(--color-ink-2);
  }

  .button--soon > span {
    white-space: nowrap;
  }

  .soon {
    font-weight: 400;
  }

  .stores-note {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--color-ink-2);
  }
</style>
