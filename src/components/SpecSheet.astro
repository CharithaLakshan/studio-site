---
import StatusBadge from './StatusBadge.astro';
import StoreButtons from './StoreButtons.astro';
import { TYPE_LABELS, formatDate, privacyUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const d = product.data;
---

<aside class="spec-sheet" aria-labelledby="spec-sheet-title">
  <h2 id="spec-sheet-title" class="visually-hidden">{d.title} at a glance</h2>
  <dl class="spec-rows">
    <div>
      <dt class="label">Status</dt>
      <dd><StatusBadge status={d.status} /></dd>
    </div>
    <div>
      <dt class="label">Type</dt>
      <dd>{TYPE_LABELS[d.type].one}</dd>
    </div>
    <div>
      <dt class="label">Platforms</dt>
      <dd>{d.platforms.join(', ')}</dd>
    </div>
    {
      d.releaseDate && (
        <div>
          <dt class="label">Release</dt>
          <dd>
            <time datetime={d.releaseDate.toISOString().slice(0, 10)}>{formatDate(d.releaseDate)}</time>
          </dd>
        </div>
      )
    }
  </dl>
  <StoreButtons links={d.storeLinks} />
  {d.hasPrivacyPolicy && <a class="spec-privacy" href={privacyUrl(product)}>Privacy policy</a>}
</aside>

<style>
  .spec-sheet {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-l);
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--rim) border-box;
    box-shadow: var(--shadow-card);
  }

  .spec-rows {
    display: grid;
  }

  .spec-rows > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .spec-rows > div:first-child {
    padding-top: 0;
  }

  .spec-privacy {
    font-size: var(--step--1);
    justify-self: start;
  }
</style>
