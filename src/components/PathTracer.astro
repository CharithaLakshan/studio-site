---
/**
 * The home hero image: a progressive path tracer (src/scripts/path-tracer.ts).
 * Before it runs, and whenever it can't, a still frame rendered by the same code is shown
 * (src/assets/hero/, regenerated with scripts/render-hero-images.mjs).
 */
import { getImage } from 'astro:assets';
import { STILL } from '../scripts/path-tracer';
import strip1 from '../assets/hero/strip-1.jpg';
import strip16 from '../assets/hero/strip-16.jpg';
import strip1024 from '../assets/hero/strip-1024.jpg';
import wide1024 from '../assets/hero/wide-1024.jpg';
import tall1024 from '../assets/hero/tall-1024.jpg';

const alt =
  'A path-traced render in a white studio: a matte cobalt sphere, a glass sphere, a chrome sphere, a small black sphere and a small white sphere, lit by one soft light.';
const wide = await getImage({ src: wide1024, widths: [960, 1600, 2400], format: 'webp' });
// The wide still is scaled like the live camera frames the scene (see STILL in path-tracer.ts).
const stillVars = `--still-kh: ${STILL.kh.toFixed(4)}; --still-kw: ${STILL.kw.toFixed(4)};`;
const tall = await getImage({ src: tall1024, widths: [432, 864], format: 'webp' });
const strip = await Promise.all(
  [
    { src: strip1, caption: '1 spp' },
    { src: strip16, caption: '16 spp' },
    { src: strip1024, caption: '1024 spp' },
  ].map(async ({ src, caption }) => ({
    caption,
    img: await getImage({ src, widths: [320, 480, 640], format: 'webp', quality: 70 }),
  })),
);
---

<figure class="pt" data-pt aria-labelledby="pt-note">
  <div class="pt-stage" data-pt-stage>
    <picture class="pt-still" style={stillVars}>
      <source media="(max-width: 39.99rem)" srcset={tall.srcSet.attribute} sizes="100vw" type="image/webp" />
      <img
        src={wide.src}
        srcset={wide.srcSet.attribute}
        sizes="140vw"
        alt={alt}
        width={wide1024.width}
        height={wide1024.height}
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <canvas class="pt-canvas" data-pt-canvas role="img" aria-label={`${alt} Rendering live.`} aria-describedby="pt-note" hidden></canvas>
    <span class="pt-focus" aria-hidden="true"></span>
    <span class="crop crop--tl" aria-hidden="true"></span>
    <span class="crop crop--tr" aria-hidden="true"></span>
    <span class="crop crop--bl" aria-hidden="true"></span>
    <span class="crop crop--br" aria-hidden="true"></span>
  </div>

  <div class="container pt-readout">
    <p class="pt-spp" aria-hidden="true"><span data-pt-spp>1024</span><small>spp</small></p>
    <p class="pt-note" id="pt-note" data-pt-note>
      This image is path-traced: each pixel averages 1024 random light paths. With JavaScript and WebGL2 on,
      it renders live in your browser.
    </p>
    <div class="pt-controls">
      <button class="button" type="button" data-pt-pause hidden>Pause</button>
      <button class="button" type="button" data-pt-restart hidden>Restart</button>
      <button class="button" type="button" data-pt-play hidden>Render it live</button>
    </div>
    <ol class="pt-strip" aria-label="The same image at 1, 16 and 1024 samples per pixel">
      {
        strip.map(({ caption, img }) => (
          <li>
            <figure>
              <div class="pt-tile">
                <img
                  src={img.src}
                  srcset={img.srcSet.attribute}
                  sizes="(min-width: 56rem) 30vw, 33vw"
                  alt=""
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
                <canvas data-pt-tile width="640" height="360" aria-hidden="true" hidden />
              </div>
              <figcaption class="label">{caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<script>
  import { mountPathTracer } from '../scripts/path-tracer-hero';
  for (const el of document.querySelectorAll<HTMLElement>('[data-pt]')) mountPathTracer(el);
</script>

<style>
  .pt {
    border-bottom: var(--rule-thick);
  }

  /*
   * Landscape screens from 40rem: the parent .hero (src/pages/index.astro) sizes the stage row to
   * the space left under the headline, so the whole render fits on the first screen. The figure
   * takes that row and the next one (the readout) through subgrid.
   */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 40rem) and (min-aspect-ratio: 1/1) {
      :global(.hero) > .pt {
        grid-row: 2 / 4;
        grid-column: 1;
        display: grid;
        grid-template-rows: subgrid;
      }

      .pt-stage.pt-stage {
        aspect-ratio: auto;
      }
    }
  }

  .pt-stage {
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .pt-still,
  .pt-still img,
  .pt-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The render's white cove is tone-mapped to the page colour; soft edges let it melt into the page. */
  .pt-still img {
    object-fit: cover;
  }

  .pt-still,
  .pt-canvas {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 88%, transparent);
  }

  .pt-still {
    overflow: hidden;
  }

  .pt-canvas {
    cursor: crosshair;
    touch-action: pan-y;
  }

  /* The mask and the screen edges would hide the canvas's own outline, so focus draws a frame between the crop marks. */
  .pt-canvas:focus-visible {
    outline: none;
  }

  .pt-focus {
    display: none;
    position: absolute;
    inset: var(--space-3) var(--gutter);
    outline: var(--focus-ring);
    pointer-events: none;
  }

  .pt-canvas:focus-visible + .pt-focus {
    display: block;
  }

  .is-live .pt-still {
    visibility: hidden;
  }

  /* Crop marks: a small printed detail at the corners of the plate. */
  .crop {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border: 0 solid var(--color-ink);
    pointer-events: none;
  }

  .crop--tl { top: var(--space-3); left: var(--gutter); border-top-width: 1.5px; border-left-width: 1.5px; }
  .crop--tr { top: var(--space-3); right: var(--gutter); border-top-width: 1.5px; border-right-width: 1.5px; }
  .crop--bl { bottom: var(--space-3); left: var(--gutter); border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .crop--br { bottom: var(--space-3); right: var(--gutter); border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .pt-readout {
    display: grid;
    gap: var(--space-4) var(--space-6);
    align-items: end;
    padding-block: var(--space-5) var(--space-7);
  }

  .pt-spp {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 2rem + 6vw, 7rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .pt-spp small {
    font-size: 0.22em;
    letter-spacing: 0;
    vertical-align: top;
    margin-left: 0.4em;
  }

  .pt-note {
    max-width: 52ch;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .pt-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pt-strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .pt-strip figure {
    display: grid;
    gap: var(--space-2);
  }

  .pt-tile {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-paper-2);
  }

  .pt-tile img,
  .pt-tile canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 40rem) {
    .pt-stage {
      aspect-ratio: 16 / 9;
    }

    /* Same framing as the live camera for any frame shape: the spheres fill the same safe area. */
    .pt-still {
      container-type: size;
    }

    .pt-still img {
      inset: 50% auto auto 50%;
      width: auto;
      max-width: none;
      height: min(calc(var(--still-kh) * 100cqh), calc(var(--still-kw) * 100cqw));
      transform: translate(-50%, -50%);
    }
  }

  @media (min-width: 56rem) {
    .pt-readout {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (min-width: 64rem) {
    .pt-stage {
      aspect-ratio: 21 / 9;
    }
  }
</style>
