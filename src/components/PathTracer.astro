---
/**
 * The home hero: a full-bleed path-traced render with the headline on top (slot) and a bar along
 * the bottom (spp counter and status, three stage thumbnails, buttons).
 *
 * The page opens on a pre-rendered 1024 spp poster (the LCP image). The live path tracer
 * (src/scripts/path-tracer.ts) is only loaded when the visitor asks for it. The poster, the stage
 * images and the live canvas share one 12:5 framing (FRAME) and one object-fit, so they line up
 * exactly. Pictures: src/assets/hero/, regenerated with scripts/render-hero-images.mjs.
 */
import { getImage } from 'astro:assets';
import poster1024 from '../assets/hero/poster-1024.jpg';
import stage1 from '../assets/hero/stage-1.jpg';
import stage16 from '../assets/hero/stage-16.jpg';
import thumb1 from '../assets/hero/thumb-1.jpg';
import thumb16 from '../assets/hero/thumb-16.jpg';
import thumb1024 from '../assets/hero/thumb-1024.jpg';

const alt =
  'A path-traced render in a white studio: a matte cobalt sphere, a glass sphere, a chrome sphere, a small black sphere and a small white sphere, lit by one soft light.';
// Quality 90: the flat studio compresses so well that at 80 the large sizes fall under Chrome's LCP
// low-entropy cut-off (0.05 bits per shown pixel) and the headline would become the LCP element.
const poster = await getImage({ src: poster1024, widths: [960, 1440, 1920, 2400, 2880], format: 'webp', quality: 90 });
// Shown size of the 12:5 poster under object-fit: cover. Phones and portrait screens: a 4:3 frame,
// 100vw wide, so the picture is 180vw wide. Otherwise the hero is one screen minus the header tall.
const posterSizes =
  '(max-width: 47.49rem) 180vw, (max-aspect-ratio: 4/3) 180vw, (min-aspect-ratio: 12/5) 100vw, calc(240vh - 10rem)';
const stages = await Promise.all(
  [
    { n: 1, src: stage1 },
    { n: 16, src: stage16 },
  ].map(async ({ n, src }) => ({ n, img: await getImage({ src, width: src.width, format: 'webp', quality: 80 }) })),
);
const thumbs = await Promise.all(
  [
    { n: 1, src: thumb1 },
    { n: 16, src: thumb16 },
    { n: 1024, src: thumb1024 },
  ].map(async ({ n, src }) => ({ n, img: await getImage({ src, widths: [120, 240], format: 'webp', quality: 80 }) })),
);
const samples = (n: number) => `${n} ${n === 1 ? 'sample' : 'samples'} per pixel`;
---

<section class="pt" data-pt aria-labelledby="hero-title">
  <div class="container pt-text">
    <slot />
  </div>

  <div class="pt-stage" data-pt-stage>
    <img
      class="pt-pic"
      src={poster.src}
      srcset={poster.srcSet.attribute}
      sizes={posterSizes}
      alt={alt}
      width={poster1024.width}
      height={poster1024.height}
      loading="eager"
      fetchpriority="high"
    />
    {
      stages.map(({ n, img }) => (
        <img
          class="pt-pic"
          data-pt-stage-img={n}
          data-src={img.src}
          alt={`${alt} Shown at ${samples(n)}, still noisy.`}
          width={stage1.width}
          height={stage1.height}
          hidden
        />
      ))
    }
    <canvas class="pt-pic pt-canvas" data-pt-canvas role="img" aria-label={`${alt} Rendering live.`} hidden></canvas>
    <span class="pt-focus" aria-hidden="true"></span>
    <span class="crop crop--tl" aria-hidden="true"></span>
    <span class="crop crop--tr" aria-hidden="true"></span>
    <span class="crop crop--bl" aria-hidden="true"></span>
    <span class="crop crop--br" aria-hidden="true"></span>
  </div>

  <div class="pt-bar">
    <div class="container pt-bar-inner">
      <div class="pt-readout">
        <p class="pt-spp" aria-hidden="true"><span data-pt-spp>1024</span><small>spp</small></p>
        <p class="pt-status" data-pt-status>Pre-rendered at {samples(1024)}.</p>
      </div>
      <ul class="pt-thumbs pt-js" aria-label="Stages of the render">
        {
          thumbs.map(({ n, img }) => (
            <li>
              <button class="pt-thumb" type="button" data-pt-thumb={n} aria-pressed={n === 1024 ? 'true' : 'false'}>
                <img src={img.src} srcset={img.srcSet.attribute} sizes="7.5rem" alt="" width="240" height="100" decoding="async" />
                <span class="label">
                  <span class="visually-hidden">Show the frame at </span>
                  {n} spp
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <div class="pt-controls pt-js">
        <button class="button button--primary" type="button" data-pt-play>Render live</button>
        <button class="button" type="button" data-pt-restart hidden>Restart</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountHero } from '../scripts/path-tracer-hero';
  for (const el of document.querySelectorAll<HTMLElement>('[data-pt]')) mountHero(el);
</script>

<style>
  .pt {
    position: relative;
    isolation: isolate;
    display: grid;
    border-bottom: var(--rule-thick);
  }

  /* Phones and portrait screens: headline, the render at 4:3, then the bar in normal flow. */
  .pt-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    cursor: crosshair;
    touch-action: pan-y;
  }

  /* Poster, stage images and canvas: one 12:5 framing, one fit, so swapping them never shifts the scene. */
  .pt-pic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .pt-canvas:focus-visible {
    outline: none;
  }

  /* The screen edges would hide the canvas's own outline, so focus draws a frame between the crop marks. */
  .pt-focus {
    display: none;
    position: absolute;
    z-index: 2;
    inset: var(--space-3) var(--gutter);
    outline: var(--focus-ring);
    pointer-events: none;
  }

  .pt-canvas:focus-visible + .pt-focus {
    display: block;
  }

  /* Crop marks: a small printed detail at the corners of the plate. */
  .crop {
    position: absolute;
    z-index: 2;
    width: 1.25rem;
    height: 1.25rem;
    border: 0 solid var(--color-ink);
    pointer-events: none;
  }

  .crop--tl { top: var(--space-3); left: var(--gutter); border-top-width: 1.5px; border-left-width: 1.5px; }
  .crop--tr { top: var(--space-3); right: var(--gutter); border-top-width: 1.5px; border-right-width: 1.5px; }
  .crop--bl { bottom: var(--space-3); left: var(--gutter); border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .crop--br { bottom: var(--space-3); right: var(--gutter); border-bottom-width: 1.5px; border-right-width: 1.5px; }

  .pt-text {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2rem, 5vw, 4rem) var(--space-5);
  }

  .pt-text :global(.lede) {
    max-width: 30ch;
  }

  .pt-bar-inner {
    display: grid;
    grid-template-areas: 'thumbs' 'readout' 'controls';
    gap: var(--space-4) var(--space-6);
    align-items: end;
    padding-block: var(--space-4) var(--space-6);
  }

  /* Thumbnails and buttons need the script; without it they keep their space but stay invisible. */
  .pt:not(.is-ready) .pt-js {
    visibility: hidden;
  }

  .pt-readout {
    grid-area: readout;
    display: grid;
    gap: var(--space-2);
  }

  .pt-spp {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  .pt-spp small {
    font-size: 0.3em;
    letter-spacing: 0;
    vertical-align: top;
    margin-left: 0.4em;
  }

  .pt-status {
    max-width: 38ch;
    min-height: calc(3 * 1.4em);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  .pt-thumbs {
    grid-area: thumbs;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 7.5rem));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .pt-thumb {
    display: grid;
    gap: var(--space-1);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
  }

  .pt-thumb img {
    width: 100%;
    aspect-ratio: 12 / 5;
    object-fit: cover;
    outline: 1px solid var(--color-hairline);
  }

  .pt-thumb[aria-pressed='true'] img {
    outline: 3px solid var(--color-blue);
  }

  .pt-thumb[aria-pressed='true'] .label {
    color: var(--color-blue);
  }

  .pt-controls {
    grid-area: controls;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  /*
   * Desktop and laptop: the render fills the first screen, edge to edge. The headline sits in the
   * plain studio above the spheres, the bar along the bottom over a soft paper fade. The height never
   * drops below 12:5 (very wide screens), so the cover crop only ever trims the sides, and the
   * spheres keep their band (BAND in path-tracer.ts).
   */
  @media (min-width: 47.5rem) and (min-aspect-ratio: 4/3) {
    .pt {
      --header-h: calc(4rem + 3px);
      grid-template-rows: auto 1fr auto;
      height: max(36rem, calc(100svh - var(--header-h)), calc(100vw * 5 / 12));
    }

    .pt-stage {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .pt-text,
    .pt-bar {
      position: relative;
      z-index: 1;
      pointer-events: none;
    }

    .pt-text > :global(*),
    .pt-readout,
    .pt-thumbs,
    .pt-controls {
      pointer-events: auto;
    }

    .pt-text {
      grid-row: 1;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
      padding-block: clamp(2.5rem, 6svh, 4.5rem) 0;
    }

    .pt-text :global(.display) {
      font-size: clamp(2.5rem, min(1rem + 6vw, 9svh), 6.5rem);
    }

    .pt-bar {
      grid-row: 3;
    }

    .pt-bar::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--space-4)) 0 0;
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-paper) 0%, transparent),
        color-mix(in srgb, var(--color-paper) 82%, transparent) 40%,
        color-mix(in srgb, var(--color-paper) 92%, transparent)
      );
    }

    .pt-bar-inner {
      position: relative;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-areas: 'readout thumbs controls';
      padding-block: var(--space-3) 2.25rem;
    }

    .pt-spp {
      font-size: clamp(2rem, 5svh, 3rem);
    }

    .pt-status {
      max-width: 48ch;
      min-height: calc(2 * 1.4em);
    }

    .pt-thumbs {
      grid-template-columns: repeat(3, 7.5rem);
    }

    .pt-controls {
      justify-content: flex-end;
    }
  }
</style>
