---
import Wordmark from './Wordmark.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label="Elsewhere">
      <SocialLinks variant="big" />
    </nav>
    <div class="site-footer-meta">
      <p>
        <a class="site-footer-home" href={url()} aria-label={`${site.name} home`}><Wordmark inverse /></a>
        <span class="site-footer-tagline">{site.tagline}</span>
      </p>
      <p>
        <a href={url('privacy/')}>Privacy</a> · © {year} {site.owner.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-5);
  }

  .site-footer :global(a) {
    color: var(--color-paper);
  }

  .site-footer :global(a:hover) {
    color: var(--color-blue-on-ink);
  }

  .site-footer :focus-visible {
    outline-color: var(--color-blue-on-ink);
  }

  .site-footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(231 229 224 / 0.35);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .site-footer-home {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    text-decoration: none;
    margin-right: var(--space-3);
  }
</style>
