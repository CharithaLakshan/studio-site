---
import { Image } from 'astro:assets';
import { responsive } from '../lib/images';
import StatusBadge from './StatusBadge.astro';
import { TYPE_LABELS, priceLabel, productUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}
const { product, headingLevel: H = 'h3' } = Astro.props;
const d = product.data;
---

<article class="card">
  <div class="card-media">
    <Image
      src={d.heroImage.src}
      alt=""
      {...responsive(d.heroImage.src, [400, 640, 960], '(min-width: 64rem) 28rem, (min-width: 40rem) 50vw, 100vw')}
    />
  </div>
  <div class="card-body">
    <p class="label">{TYPE_LABELS[d.type].one} · {d.platforms.join(', ')}</p>
    <H class="card-title"><a href={productUrl(product)}>{d.title}</a></H>
    <p class="card-tagline">{d.tagline}</p>
    <div class="card-meta">
      <span class="card-price">{priceLabel(d)}</span>
      <StatusBadge status={d.status} />
    </div>
  </div>
</article>

<style>
  /* A printed card: 2px ink border and a hard offset shadow. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 2px solid var(--color-ink);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-card-hover);
  }

  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--color-ink);
    background: var(--color-paper-2);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    flex: 1;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-5);
  }

  .card-title {
    font-size: var(--step-2);
  }

  .card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 6px;
  }

  .card-tagline {
    color: var(--color-ink-2);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--rule);
  }

  .card-price {
    font-weight: 700;
  }
</style>
