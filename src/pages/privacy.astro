---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
import { formatDate } from '../lib/products';

// TODO(charitha): review this policy and update the date when anything changes.
const lastUpdated = new Date('2026-10-08');
---

<BaseLayout title="Privacy" description={`Privacy policy for the ${site.name} website. No tracking, no cookies.`}>
  <PageHeader title="Privacy" label="This website">
    <p class="label muted">
      Last updated <time datetime={lastUpdated.toISOString().slice(0, 10)}>{formatDate(lastUpdated)}</time>
    </p>
  </PageHeader>

  <div class="container page-body">
    <div class="prose">
      <p>
        This policy covers this website only. Each product that needs its own policy has one, linked from its
        product page.
      </p>

      <h2>The short version</h2>
      <ul>
        <li>No analytics, no tracking, no advertising.</li>
        <li>This site does not set cookies.</li>
        <li>Fonts, images and scripts are served from this site, not from third parties.</li>
        <li>No forms, accounts or comments, so you never send personal data to this site.</li>
      </ul>

      <h2>The live image on the home page</h2>
      <p>
        The home page renders an image in your browser with WebGL. It runs on your device only. Nothing about it
        is sent anywhere.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on GitHub Pages. Like any web host, GitHub may log technical data such as your IP
        address when you request a page. See the{' '}
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub General Privacy Statement</a>.
      </p>

      <h2>Trailers</h2>
      <p>
        Product trailers are hosted on YouTube. Nothing is loaded from YouTube until you press play. When you do,
        the video loads from youtube-nocookie.com and Google’s{' '}
        <a href="https://policies.google.com/privacy">privacy policy</a> applies to that video.
      </p>

      <h2>Links to other sites</h2>
      <p>
        Store buttons and other links take you to other sites, for example Steam, the Meta Horizon Store, Google
        Play, itch.io or YouTube. Their own privacy policies apply there.
      </p>

      <h2>Contact</h2>
      <p>
        {
          site.email ? (
            <>
              Questions about this policy: <a href={`mailto:${site.email}`}>{site.email}</a>.
            </>
          ) : (
            <>
              Questions about this policy can be raised on <a href={site.socials.github}>GitHub</a>.
            </>
          )
        }
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: clamp(2rem, 5vw, 4rem);
  }
</style>
