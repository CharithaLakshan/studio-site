---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
import { formatDate } from '../lib/products';

// TODO(charitha): review this policy and update the date when anything changes.
const lastUpdated = new Date('2026-10-07');
---

<BaseLayout title="Privacy" description={`Privacy policy for the ${site.name} website. No tracking, no cookies.`}>
  <PageHeader title="Privacy" label="This website">
    <p class="label">
      Last updated <time datetime="2026-10-07">{formatDate(lastUpdated)}</time>
    </p>
  </PageHeader>

  <div class="container">
    <div class="prose">
      <p>
        This policy covers this website only. Each product that needs its own policy has one, linked
        from its product page.
      </p>

      <h2>The short version</h2>
      <ul>
        <li>No analytics, no tracking, no advertising.</li>
        <li>This site does not set cookies.</li>
        <li>Fonts and images are served from this site, not from third parties.</li>
        <li>No forms, accounts or comments, so you never send personal data to this site.</li>
      </ul>

      <h2>Hosting</h2>
      <p>
        The site is hosted on GitHub Pages. Like any web host, GitHub may log technical data such as
        your IP address when you request a page. See the
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub General Privacy Statement</a>.
      </p>

      <h2>Trailers</h2>
      <p>
        Product trailers are hosted on YouTube. Nothing is loaded from YouTube until you press play.
        When you do, the video loads from youtube-nocookie.com and Google's
        <a href="https://policies.google.com/privacy">privacy policy</a> applies to that video.
      </p>

      <h2>Links to other sites</h2>
      <p>
        Store buttons and social links take you to other sites (for example Steam, the Meta Horizon
        Store or YouTube). Their own privacy policies apply there.
      </p>

      <h2>Contact</h2>
      <p>
        {
          site.email ? (
            <>
              Questions about this policy: <a href={`mailto:${site.email}`}>{site.email}</a>.
            </>
          ) : (
            <>
              Questions about this policy can be raised on <a href={site.socials.github}>GitHub</a>.
            </>
          )
        }
      </p>
    </div>
  </div>
</BaseLayout>
