---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProduct from '../components/FeaturedProduct.astro';
import PathTracer from '../components/PathTracer.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../config/site';
import { getFeaturedProduct, getProducts } from '../lib/products';
import { url } from '../lib/url';

const products = await getProducts();
const featured = await getFeaturedProduct();
const { owner } = site;
const hasPortfolio = !!(site.portfolioUrl as string);
let n = 0;
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-text">
      <h1 id="hero-title" class="display">{site.headline}</h1>
      <p class="lede">{site.tagline}</p>
    </div>
    <PathTracer />
  </section>

  {
    featured && (
      <Section n={++n} label="Featured product" title={featured.data.title} id="featured">
        <FeaturedProduct product={featured} />
      </Section>
    )
  }

  <Section n={++n} label="Everything I make" title="Products" id="products">
    <ProductGrid products={products} />
    <p class="more">
      <a class="button" href={url('products/')}>All products by platform <span class="button-arrow" aria-hidden="true">→</span></a>
    </p>
  </Section>

  <Section n={++n} label="Who makes these" title="About" id="about">
    <div class="about">
      <p>
        I’m {owner.name}, “{owner.alias}” online, and I make these on my own in {owner.location}. Each product
        has its own page with the price, the platforms and a link to the store.
        {hasPortfolio && ' My background and other projects are on my portfolio.'}
      </p>
      <SocialLinks />
    </div>
  </Section>
</BaseLayout>

<style>
  .hero-text {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2rem, 5vw, 4rem) var(--space-5);
  }

  .hero-text .lede {
    max-width: 30ch;
  }

  @media (min-width: 56rem) {
    .hero-text {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
    }
  }

  /*
   * Landscape screens: the first screen holds the header, the headline and the whole render.
   * The ::before spacer spans the text row and the stage row and is exactly one screen minus the
   * header tall, so the stage row (1fr) gets what the text leaves. PathTracer.astro puts its stage
   * in row 2 and its readout in row 3 (subgrid). The headline is capped at about a third of the screen.
   */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 40rem) and (min-aspect-ratio: 1/1) {
      .hero {
        --header-h: calc(4rem + 3px);
        display: grid;
        grid-template-rows: auto minmax(15rem, 1fr) auto;
      }

      .hero::before {
        content: '';
        grid-row: 1 / 3;
        grid-column: 1;
        height: calc(100svh - var(--header-h));
      }

      .hero-text {
        grid-row: 1;
        grid-column: 1;
        padding-block: clamp(1.5rem, min(5vw, 5svh), 4rem) var(--space-4);
      }

      .hero-text .display {
        font-size: clamp(2.75rem, min(1rem + 7.4vw, 11svh), 8.5rem);
      }
    }
  }

  .more {
    margin-top: var(--space-6);
  }

  .about {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .about p {
    font-size: var(--step-1);
    line-height: 1.4;
  }
</style>
