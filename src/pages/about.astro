---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

const { owner } = site;
const portfolio = site.portfolioUrl;
---

<BaseLayout title="About" description={`${site.name} is the one-person studio of ${owner.name}. This site lists the products.`}>
  <PageHeader title="About" label={site.name} />

  <div class="container about">
    <div class="prose">
      <p>
        {site.name} is my one-person studio. I’m {owner.name}, “{owner.alias}” online, and I live in {owner.location}.
      </p>
      <p>
        I make games, VR apps and tools. Some are free and some are paid. Each one has a page here with its price,
        its platforms and a link to the store where you can get it.
      </p>
      <p>
        This site is only about the products.{' '}
        {
          portfolio ? (
            <>
              My background, projects and research are on <a href={portfolio} rel="me noopener">my portfolio</a>.
            </>
          ) : (
            <>See the links below for what else I do.</>
          )
        }
      </p>
      <p><a class="button button--primary" href={url('products/')}>See the products <span class="button-arrow" aria-hidden="true">→</span></a></p>
    </div>
    <SocialLinks />
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .about .prose {
    font-size: var(--step-1);
    line-height: 1.45;
  }
</style>
