---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="container not-found" aria-labelledby="nf-title">
    <p class="rail-number" aria-hidden="true">404</p>
    <h1 id="nf-title" class="display">No page here.</h1>
    <p class="lede">It doesn’t exist, or it moved. The products are still where they were.</p>
    <p class="actions">
      <a class="button button--primary" href={url('products/')}>See all products</a>
      <a class="button" href={url()}>Go home</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: clamp(3rem, 10vw, 8rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
</style>
