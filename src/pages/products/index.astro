---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import Section from '../../components/Section.astro';
import { site } from '../../config/site';
import { getProducts, groupByPlatform } from '../../lib/products';

const products = await getProducts();
const groups = groupByPlatform(products);
const count = (k: number) => `${k} product${k === 1 ? '' : 's'}`;
const description = `Every game, VR app and tool from ${site.name}, grouped by platform, with prices and store links.`;
---

<BaseLayout title="Products" description={description}>
  <PageHeader
    title="Products"
    label={count(products.length)}
    lede="Everything I make, grouped by platform. If something runs on two platforms, it’s listed under both."
  >
    {
      groups.length > 1 && (
        <nav aria-label="Platforms">
          <ul class="platform-nav" role="list">
            {groups.map((g) => (
              <li>
                <a class="button" href={`#${g.id}`}>
                  {g.label} <span aria-hidden="true">·</span> {g.items.length}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </PageHeader>

  {
    groups.map((g, i) => (
      <Section n={i + 1} label={count(g.items.length)} title={g.label} id={g.id}>
        <ProductGrid products={g.items} />
      </Section>
    ))
  }
</BaseLayout>

<style>
  .platform-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
</style>
