---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FeatureList from '../../../components/FeatureList.astro';
import Gallery from '../../../components/Gallery.astro';
import Section from '../../../components/Section.astro';
import SpecTable from '../../../components/SpecTable.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import StoreButtons from '../../../components/StoreButtons.astro';
import SystemRequirements from '../../../components/SystemRequirements.astro';
import Trailer from '../../../components/Trailer.astro';
import { responsive } from '../../../lib/images';
import { TYPE_LABELS, getProducts, priceLabel, privacyUrl, type Product } from '../../../lib/products';
import { productJsonLd, socialImageFor } from '../../../lib/seo';
import { absolute, url } from '../../../lib/url';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const d = product.data;
const { Content } = await render(product);
const image = await socialImageFor(d.heroImage.src, d.heroImage.alt);
const jsonLd = productJsonLd(product, absolute(Astro.url.pathname), image);

// Optional sections are numbered only when present, so the rail always reads 01, 02, 03...
let n = 0;
---

<BaseLayout title={`${d.title}: ${d.tagline.replace(/[.!]$/, '')}`} description={d.summary} image={image} jsonLd={jsonLd}>
  <article class="product">
    <header class="container product-head">
      <a class="label back-link" href={url('products/')}>← All products</a>
      <p class="label">{TYPE_LABELS[d.type].one} · {d.platforms.join(', ')}</p>
      <h1 class="display">{d.title}</h1>
      <p class="lede">{d.tagline}</p>
    </header>

    <div class="storefront-band">
      <div class="container storefront">
        <div class="storefront-media">
          <Image
            src={d.heroImage.src}
            alt={d.heroImage.alt}
            {...responsive(d.heroImage.src, [640, 1024, 1600, 2100], '(min-width: 64rem) 60rem, 100vw')}
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <aside class="buybox" aria-labelledby="buybox-title">
          <h2 id="buybox-title" class="visually-hidden">Get {d.title}</h2>
          <div class="buybox-price">
            <span class="label">Price</span>
            <span class="price">{priceLabel(d)}</span>
          </div>
          <dl class="buybox-facts">
            <div><dt class="label">Status</dt><dd><StatusBadge status={d.status} /></dd></div>
            <div><dt class="label">Platforms</dt><dd>{d.platforms.join(', ')}</dd></div>
          </dl>
          <StoreButtons product={product} />
          {d.hasPrivacyPolicy && <a class="buybox-privacy" href={privacyUrl(product)}>Privacy policy</a>}
        </aside>
      </div>
    </div>

    <Section n={++n} label="Overview" title="What it is">
      <div class="prose description"><Content /></div>
    </Section>

    {
      d.trailerYouTubeId && (
        <Section n={++n} label="Video" title="Trailer">
          <Trailer youTubeId={d.trailerYouTubeId} title={d.title} poster={d.heroImage.src} />
        </Section>
      )
    }

    {
      d.screenshots.length > 0 && (
        <Section n={++n} label={`${d.screenshots.length} image${d.screenshots.length === 1 ? '' : 's'}`} title="Screenshots">
          <Gallery images={d.screenshots} />
        </Section>
      )
    }

    {
      d.features.length > 0 && (
        <Section n={++n} label="Features" title="What it does">
          <FeatureList features={d.features} />
        </Section>
      )
    }

    <Section n={++n} label="Details" title="Specs">
      <SpecTable product={product} caption={`${d.title} specs`} />
    </Section>

    {
      d.systemRequirements && (
        <Section n={++n} label="Hardware" title="System requirements">
          <SystemRequirements requirements={d.systemRequirements} />
        </Section>
      )
    }
  </article>
</BaseLayout>

<style>
  .product-head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-block: var(--space-5) var(--space-6);
  }

  .back-link {
    color: var(--color-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-bottom: var(--space-2);
  }

  .back-link:hover {
    color: var(--color-blue);
  }

  .product-head .lede {
    max-width: 40ch;
  }

  /* Full-bleed rule, like every other section. */
  .storefront-band {
    border-bottom: var(--rule-thick);
  }

  .storefront {
    display: grid;
    gap: var(--space-6);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .storefront-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    background: var(--color-paper-2);
  }

  .storefront-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .buybox {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .buybox-price {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
    border-bottom: var(--rule);
  }

  .price {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .buybox-facts {
    display: grid;
  }

  .buybox-facts > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: var(--rule);
  }

  .buybox-facts dd {
    font-size: var(--step-0);
  }

  .buybox-privacy {
    justify-self: start;
    font-size: var(--step--1);
  }

  .description {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (min-width: 64rem) {
    .storefront {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: start;
    }

    .buybox {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
